{
  "name": "qa-agent-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + agent runner that autofills QA Studio executions",
  "type": "commonjs",
  "scripts": {
    "start": "node src/cli.js",
    "test:agent": "node src/cli.js",
    "test:unit": "node --test src/*.test.js",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.51.0",
    "dotenv": "^16.6.1"
  },
  "optionalDependencies": {
    "@cursor/sdk": "^1.0.0"
  }
}
