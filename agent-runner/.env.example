# Copie para agent-runner/.env (não commitar segredos)

# API do QA Studio (deve estar rodando)
QA_API_BASE=http://localhost:3001/api

# App externo sob teste (SUT) — altere para a URL real do sistema
TARGET_BASE_URL=https://example.com

# Ambiente gravado na execução
TEST_ENV=Homologação

# Agent: opencode (padrão) | cursor
AGENT=opencode

# Browser visível ao rodar Playwright (1 = sim)
HEADED=1

# Reuso de sessão (login SSO manual) entre casos da fila. 1 desliga o salvamento.
# SSO_STATE_OFF=1
# Em headless sem sessão salva, falha rápido em vez de travar no SSO.
# Defina 1 para aguardar a confirmação "Já fiz login" do Studio mesmo em headless.
# SSO_HEADLESS_WAIT=1

# Avisa quando a sessão SSO salva tem mais de N dias (pode ter expirado).
# SSO_STATE_MAX_AGE_DAYS=7

# Reexecuta o caso automaticamente em falha (ex.: 1 na CI para UI flaky).
# PLAYWRIGHT_RETRIES=1

# Quantas vezes retenta um caso que falhou por infraestrutura (timeout/crash/rede), não por veredito.
# CASE_RETRIES=1

# Quantos bundles de evidência manter em artifacts/runs/ (mais antigos são apagados).
# EVIDENCE_RUNS=20

# --- OpenCode ---
OPENCODE_BIN=opencode
# Modelo de texto (não use *-image*). Padrão no runner: google/gemini-2.5-flash
# OPENCODE_MODEL=google/gemini-2.5-flash
OPENCODE_AUTO=1
# OpenCode (Google) lê esta var; se omitida, o runner reaproveita GEMINI_API_KEY da raiz.
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Cursor SDK (opcional) ---
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
