# Copie para agent-runner/.env (não commitar segredos)

# API do QA Studio (deve estar rodando)
QA_API_BASE=http://localhost:3001/api

# App externo sob teste (SUT) — altere para a URL real do sistema
TARGET_BASE_URL=https://example.com

# Ambiente gravado na execução
TEST_ENV=Homologação

# Agent: opencode (padrão) | cursor
AGENT=opencode

# Browser visível ao rodar Playwright (1 = sim)
HEADED=1

# Reuso de sessão (login SSO manual) entre casos da fila. 1 desliga o salvamento.
# SSO_STATE_OFF=1

# Reexecuta o caso automaticamente em falha (ex.: 1 na CI para UI flaky).
# PLAYWRIGHT_RETRIES=1

# --- OpenCode ---
OPENCODE_BIN=opencode
# OPENCODE_MODEL=provider/model
OPENCODE_AUTO=1

# --- Cursor SDK (opcional) ---
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
