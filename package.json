{
  "name": "qa-test-studio",
  "version": "1.0.0",
  "private": true,
  "description": "QA Studio - Aplicativo de testes para QA (gestão integrada do ciclo de testes)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node scripts/test-api.js",
    "test:unit": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "backup": "node scripts/backup.js",
    "test:agent": "npm --prefix agent-runner start --",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
